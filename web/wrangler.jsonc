{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "bbsystems-us",
	"compatibility_date": "2026-08-21",
	"main": "worker/index.ts",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS"
	},
	"send_email": [
		{ "name": "EMAIL" }
	],
	"routes": [
		{ "pattern": "bbsystems.us", "custom_domain": true },
		{ "pattern": "www.bbsystems.us", "custom_domain": true }
	]
}
